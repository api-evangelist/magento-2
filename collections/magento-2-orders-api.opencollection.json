{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adobe Commerce (Magento 2) REST Auth Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/rest/{storeCode}/V1/orders",
            "params": [
              {
                "name": "searchCriteria",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search orders"
        },
        {
          "info": {
            "name": "Get order by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/rest/{storeCode}/V1/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get order by ID"
        }
      ]
    }
  ],
  "bundled": true
}